# Raw NASA FIRMS CSV folder used by the command-line batch pipeline
SUTELLITE_DATA_DIR=

# Canonical Parquet folder used by the built-in website explorer
SUTELLITE_CANONICAL_DIR=processed/canonical_v1.1

# Optional local ESA WorldCover 2021 GeoTIFF tiles; missing tiles display as "No data"
SUTELLITE_WORLDCOVER_DIR=data/worldcover

# Optional folder containing regional AI prediction CSV outputs from ai.run_model
SUTELLITE_AI_RESULTS_DIR=
